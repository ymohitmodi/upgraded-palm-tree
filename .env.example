# ──────────────────────────────────────────────────────────────────────────
# NYX — Autonomous Dark Factory configuration
# Copy to `.env`. Every value has a safe default; with NO key set, NYX runs in
# deterministic MOCK mode so the entire factory works offline.
# ──────────────────────────────────────────────────────────────────────────

# --- The Brain: Ollama Cloud -------------------------------------------------
# Get a key at https://ollama.com  (Free / Pro $20 / Max $100).
# Leave blank to force MOCK mode.
OLLAMA_API_KEY=
# Ollama Cloud host (OpenAI-compatible endpoint lives at <host>/v1).
OLLAMA_HOST=https://ollama.com

# Model routing — bare model ids on ollama.com (NO `-cloud` suffix). Verify the
# names against your account: GET https://ollama.com/v1/models.
# Default: deepseek-v4-flash for every role — 1M-token context (whole filings
# fit), no long reasoning phase, cheap enough to parse at scale. Swap the
# architect/reviewer for a heavier thinker (e.g. qwen3.5:397b / glm-5.1) if you
# prefer depth over speed.
NYX_MODEL_ARCHITECT=deepseek-v4-flash
NYX_MODEL_CODER=deepseek-v4-flash
NYX_MODEL_REVIEWER=deepseek-v4-flash
NYX_MODEL_FAST=deepseek-v4-flash
# Embedding model for semantic memory recall (hashing fallback in mock mode).
NYX_MODEL_EMBED=nomic-embed-text

# --- Factory behavior --------------------------------------------------------
# How many agents fan out per pipeline stage (best result wins).
NYX_FANOUT=3
# Autonomy level: assisted | supervised | autonomous (lights-out)
NYX_AUTONOMY=supervised
# Hard ceiling on model calls per factory run (cost guard).
NYX_MAX_CALLS=200

# --- Constitution ------------------------------------------------------------
NYX_CONSTITUTION=constitution/constitution.yaml
# Block (fail-closed) or warn when a constitutional check fails.
NYX_CONSTITUTION_MODE=block

# --- Evolution ---------------------------------------------------------------
NYX_EVOLUTION_ARCHIVE=.nyx/evolution_archive
# Minimum score improvement over a parent to admit a child to the archive.
NYX_EVOLUTION_THRESHOLD=0.02

# --- Memory & context --------------------------------------------------------
NYX_MEMORY=.nyx/memory.jsonl
# 1 = one memory file per capability (memory-value-investing.jsonl, …) so
# domains never pollute each other's recall. The web cache is likewise
# partitioned by host (webcache/<host>/) for management.
NYX_MEMORY_PER_CAPABILITY=1
# Working-memory budget (chars carried between pipeline stages).
NYX_CONTEXT_BUDGET=4000
# Run a memory "sleep"/consolidation pass every N cycles.
NYX_CONSOLIDATE_EVERY=5

# --- Tools / connectivity (live data; see docs/TOOLS.md) ---------------------
# SEC requires a real contact for EDGAR access. Format: "Name email".
EDGAR_IDENTITY=
# Polite web crawling.
NYX_USER_AGENT=nyx-dark-factory/0.1 (+research; contact@example.com)
NYX_WEB_CACHE=.nyx/webcache
NYX_WEB_RATE_LIMIT=1.0
# Comma-separated egress allowlist for autonomous runs (empty = allow all).
# For live investing: sec.gov,www.sec.gov,data.sec.gov,efts.sec.gov,finance.yahoo.com,berkshirehathaway.com,www.berkshirehathaway.com,news.google.com
NYX_ALLOWED_DOMAINS=
# MCP server manifest (nyx mcp-init writes sec-edgar-mcp here).
NYX_MCP_MANIFEST=.nyx/mcp.json

# --- Observability & evaluation ----------------------------------------------
NYX_LEDGER=.nyx/audit.ledger.jsonl
NYX_LOG_LEVEL=INFO
# Held-out evaluation score history (nyx eval).
NYX_EVAL_HISTORY=.nyx/evals.jsonl
